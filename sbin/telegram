#!/bin/sh
# `.` rather than `source`: busybox ash takes either, but /bin/sh on a
# developer machine is often dash, which has only the POSIX spelling.
[ -e "/etc/webui/telegram.conf" ] && . /etc/webui/telegram.conf

if [ "$telegram_enabled" != "true" ]; then
	echo "Sending to Telegram is not enabled"
	exit 1
fi

if [ -z "$telegram_token" ]; then
	echo "Telegram token not found"
	exit 1
fi

if [ -z "$telegram_channel" ]; then
	echo "Telegram channel not found"
	exit 1
fi

if [ -z "$telegram_caption" ]; then
	telegram_message="$(hostname -s), $(date +'%F %T')"
else
	telegram_message="$(echo "$telegram_caption" | sed "s/%hostname/$(hostname -s)/;s/%datetime/$(date +"%F %T")/;s/%soctemp/$(ipcinfo --temp)/")"
fi

# Both files below live in a private directory rather than straight in /tmp.
# This script runs as root, from cron and from a webhook anyone who can reach the
# camera can fire, and the old paths were fully predictable -- hostname and
# timestamp for the snapshot, the pid for the response -- so a symlink planted at
# either path would have been followed and clobbered. mktemp -d keeps the
# snapshot's basename, which is what Telegram shows as the document name.
workdir=$(mktemp -d /tmp/telegram.XXXXXX) || exit 1
trap 'rm -rf "$workdir"' EXIT INT TERM

# Called with a path, send that file instead of taking a picture. That is how
# majestic hands over a finished recording, and the recording is the whole
# point of the call: a still taken now shows what the camera can see now, not
# what set the recorder off a minute ago.
#
# The file belongs to whoever called, so it is never put in the workdir and
# never removed -- the trap above only takes away what this script created.
if [ -n "$1" ]; then
	snapshot=$1
	if [ ! -s "$snapshot" ]; then
		echo "Nothing to send: $snapshot"
		exit 1
	fi
else
	filename="$(hostname -s | tr ' ' '-')"-"$(date +'%Y%m%d-%H%M%S')"
	if [ "$telegram_heif" = "true" ]; then
		snapshot=$workdir/${filename}.heif
		wget -q -T1 localhost/image.heif -O "$snapshot"
	else
		snapshot=$workdir/${filename}.jpg
		wget -q -T1 localhost/image.jpg -O "$snapshot"
	fi

	if [ ! -e "$snapshot" ]; then
		echo "Snapshot file not found"
		exit 1
	fi
fi

command="curl --verbose"
command="${command} --connect-timeout 100"
command="${command} --max-time 100"

if [ "$telegram_proxy" = "true" ] && [ -e "/etc/webui/proxy.conf" ]; then
	. /etc/webui/proxy.conf
	command="${command} --socks5-hostname ${socks5_host}:${socks5_port}"
	command="${command} --proxy-user ${socks5_username}:${socks5_password}"
fi

command="${command} -F 'chat_id=${telegram_channel}'"
if [ -n "$telegram_thread_id" ]; then
	command="${command} -F 'message_thread_id=${telegram_thread_id}'"
fi 
command="${command} --url https://api.telegram.org/bot${telegram_token}"

# HEIF is not a valid sendPhoto format (Telegram only accepts JPEG/PNG/GIF/WEBP),
# so always send it via sendDocument. A clip goes to sendVideo, which is what
# gives the reader a player rather than a file to download first -- unless the
# document switch is on, which says the sender wants the bytes untouched.
if [ "$telegram_document" = "true" ] || [ "${snapshot##*.}" = "heif" ]; then
	command="${command}/sendDocument"
	command="${command} -F 'document=@${snapshot}'"
elif [ "${snapshot##*.}" = "mp4" ]; then
	command="${command}/sendVideo"
	command="${command} -F 'video=@${snapshot}'"
	command="${command} -F 'supports_streaming=true'"
else
	command="${command}/sendPhoto"
	command="${command} -F 'photo=@${snapshot}'"
fi
command="${command} -F 'caption=${telegram_message}'"

# The response body still goes to stdout for anyone running this by hand or out
# of cron. What is new is the exit status: this used to `exit 0` unconditionally,
# so a rejected send reported success and telegram.cgi's ?send=image webhook
# had to dig `ok` out of the JSON body with jsonfilter to find out otherwise.
# Telegram answers a rejected send with 4xx, so the HTTP code alone settles it
# and the camera no longer needs a JSON parser on flash for this.
#
# --write-out rather than --fail-with-body: curl is pinned at 7.76.0 in the
# firmware, the very release that added --fail-with-body, so going through the
# status code leaves no version floor to trip over later.
#
# The command line is no longer echoed. It carries the bot token, and printing it
# was the only reason the webhook had to filter its own output before parsing it.
body=$workdir/response.json
command="${command} --output '${body}' --write-out '%{http_code}'"

http=$(eval "$command")
[ -s "$body" ] && cat "$body"

case "$http" in
200) exit 0 ;;
*) exit 1 ;;
esac
