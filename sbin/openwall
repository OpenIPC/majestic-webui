#!/bin/sh
[ -e "/etc/webui/openwall.conf" ] && . /etc/webui/openwall.conf

flash_size=$(awk '{sum+=sprintf("0x%s", $2);} END{print sum/1048576;}' /proc/mtd)
fw_variant=$(grep "BUILD_OPTION" /etc/os-release | cut -d= -f2 | tr -d '"')
fw_version=$(grep "OPENIPC_VERSION" /etc/os-release | cut -d= -f2 | tr -d '"')

network_hostname=$(hostname -s)
network_interface=$(ip route | awk '/default/ {print $5}')
network_macaddr=$(cat "/sys/class/net/${network_interface}/address")

if [ "$(ipcinfo -v)" = "sigmastar" ]; then
	soc=$(fw_printenv -n soc)
else
	soc=$(ipcinfo --chip-name)
fi

sensor=$(fw_printenv -n sensor)
streamer=$(basename $(ipcinfo --streamer))
temperature=$(ipcinfo --temp)
uptime=$(uptime | sed -r 's/^.+ up ([^,]+), .+$/\1/')

if [ "$openwall_enabled" != "true" ]; then
	echo "Sending to Openwall is not enabled"
	exit 1
fi

# The picture is the camera's own keyframe in HEIF, never a JPEG. The wall
# stores what it is sent byte for byte and hands visitors that same keyframe to
# decode, so what goes up here is exactly what gets shown: at the same size it
# is about half the bytes of the JPEG the encoder would make of the same frame.
#
# The second picture is the substream's keyframe, which the wall's grid shows
# in place of scaling the main one down in every visitor's browser. It is not
# asked for while the substream is known to be off: asked of a stream that is
# off, the camera holds the request open instead of refusing it. When the
# setting cannot be read at all, that is not the same as "off", so the picture
# is asked for anyway -- -T bounds what a wrong guess costs -- and the upload
# goes ahead with or without it.
#
# Each run works in a directory of its own, so a run that starts before the
# previous one has finished cannot remove the files that one is uploading.
workdir=$(mktemp -d /tmp/openwall.XXXXXX) || exit 1
snapshot="$workdir/main.heif"
thumb="$workdir/thumb.heif"
trap 'rm -f "$snapshot" "$thumb"; rmdir "$workdir"' EXIT

wget -q -T 10 localhost/image.heif -O "$snapshot"

. /var/www/cgi-bin/p/majestic.sh
substream=$(mj_cfg video1.enabled)
case $? in
	0) [ "$substream" = "true" ] && want_thumb=1 ;;
	1) ;; # no such setting: no substream
	*) echo "Could not read whether the substream is on; asking for its picture anyway"
	   want_thumb=1 ;;
esac
[ -n "$want_thumb" ] && wget -q -T 10 "localhost/image.heif?stream=1" -O "$thumb"

# -s, not -e: a wget that fails still leaves the file it opened, empty.
if [ ! -s "$snapshot" ]; then
	echo "Snapshot could not be taken"
	exit 1
fi

if [ -z "$network_macaddr" ]; then
	echo "MAC address not found"
	exit 1
fi

# An argument list, not a command line handed to eval.
#
# Almost everything below is read off the device or out of a form, and several
# of them can hold a space or a quote: the caption is free prose an operator
# typed, the camera's own name is whatever `hostname` returns, and the proxy
# credentials come from the proxy page. The lines this replaced wrapped each
# value in single quotes and escaped nothing inside them, so an apostrophe in
# any one of them -- a caption reading `Ivan's yard` -- ended the quoting early
# and handed the remainder of the upload to the shell, while the proxy user and
# password were pasted in with no quoting at all. Passed as "$@" the values need
# no quoting rules: each one reaches curl whole (#547).
#
# --speed-limit/--speed-time end an upload that has stopped moving. In Russia
# the TSPU freezes a TLS connection to openipc.org's hosting network after the
# first 20-odd kilobytes: the handshake completes, the picture starts to go up,
# and then nothing passes in either direction. Without these curl sits out its
# whole --max-time on a connection that is already dead.
set -- curl --verbose --connect-timeout 100 --max-time 100 \
	--speed-limit 1024 --speed-time 15

if [ "$openwall_proxy" = "true" ] && [ -e "/etc/webui/proxy.conf" ]; then
	. /etc/webui/proxy.conf
	set -- "$@" --socks5-hostname "${socks5_host}:${socks5_port}"
	set -- "$@" --proxy-user "${socks5_username}:${socks5_password}"
fi

set -- "$@" -F "mac_address=${network_macaddr}"
set -- "$@" -F "firmware=${fw_version}-${fw_variant:-lite}"
set -- "$@" -F "flash_size=${flash_size}"
set -- "$@" -F "hostname=${network_hostname}"
set -- "$@" -F "caption=${openwall_caption}"
set -- "$@" -F "sensor=${sensor}"
set -- "$@" -F "soc=${soc}"
set -- "$@" -F "soc_temperature=${temperature}"
set -- "$@" -F "streamer=${streamer}"
set -- "$@" -F "uptime=${uptime}"
set -- "$@" -F "file=@${snapshot};type=image/heif"
[ -s "$thumb" ] && set -- "$@" -F "thumb=@${thumb};type=image/heif"

# The command line is not echoed. It carries --proxy-user, and this runs from
# cron, so the credential went wherever that camera sends its cron output. The
# two notification senders each dropped the same echo for the same reason.
#
# openipc.ru is the same wall, proxied from a host inside Russia, so a camera
# there that cannot reach openipc.org reaches it through the mirror (measured
# 2026-10-03: every upload that arrived through openipc.ru was stored, while
# direct uploads from cameras in Russia froze). It is tried only when curl
# itself fails -- a stall, a refused or dropped connection. An answer from the
# wall, a 429 for sending too soon included, is the wall's answer wherever it
# was asked, and is not asked again. A frozen upload never reached the wall,
# so the second one is not refused as too soon.
if ! "$@" --url https://openipc.org/snapshots; then
	echo "Upload to openipc.org failed; sending through openipc.ru"
	"$@" --url https://openipc.ru/snapshots
fi

exit 0
